# EXAMPLE: copy to /etc/systemd/system/ and replace every <user> and /home/<user>/ghosty-sessions with your own
# user and checkout path (see docs/INSTALL.md). Not installable as is.
[Unit]
Description=Ghosty Sessions — tmux pane dashboard for codebox
Documentation=file:///home/<user>/ghosty-sessions/README.md
After=network-online.target tailscaled.service
After=tmux.service
Wants=network-online.target

[Service]
Type=simple
User=<user>
WorkingDirectory=/home/<user>/ghosty-sessions
ExecStart=/usr/bin/env node /home/<user>/ghosty-sessions/server.js
Restart=on-failure
RestartSec=3
# A running deploy is a detached child (deploy-runner.js); a stop must not kill it, the restarted ghosty re-adopts it.
KillMode=process
Environment=PORT=7777
Environment=HOST=127.0.0.1
Environment=TICK_MS=1000
Environment=PANE_LINES=2000
Environment=TLS_KEY=/home/<user>/ghosty-sessions/certs/key.pem
Environment=TLS_CERT=/home/<user>/ghosty-sessions/certs/cert.pem
Environment=TLS_PORT=7443
# Secrets (NTFY_TOPIC, PUBLIC_URL) live in the gitignored .env next to server.js; optional.
EnvironmentFile=-/home/<user>/ghosty-sessions/.env
# Langfuse keys (prompt management for the AI reviewer)
EnvironmentFile=-/home/<user>/.config/ghosty/usage.env
# Loopback behind private Tailscale Serve (see docs/INSTALL.md), or a literal Tailscale IP
# for direct access. Never 0.0.0.0: the server has no login.
NoNewPrivileges=true
PrivateTmp=false

[Install]
WantedBy=multi-user.target
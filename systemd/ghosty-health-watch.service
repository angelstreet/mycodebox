# EXAMPLE: copy to /etc/systemd/system/ and replace every <user> and /home/<user>/ghosty-sessions with your own
# user and checkout path (see docs/INSTALL.md). Not installable as is.
[Unit]
Description=Ghosty: token-free codebox health watchdog (disk, load, RAM, runaways; wakes the AI manager only if a problem remains)

[Service]
Type=oneshot
User=<user>
Environment=HOME=/home/<user>
ExecStart=/usr/local/bin/node /home/<user>/ghosty-sessions/scripts/health-watch.js
TimeoutStartSec=10min
Nice=10

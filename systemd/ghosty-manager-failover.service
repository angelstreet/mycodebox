# EXAMPLE: copy to /etc/systemd/system/ and replace every <user> and /home/<user>/ghosty-sessions with your own
# user and checkout path (see docs/INSTALL.md). Not installable as is.
[Unit]
Description=Ghosty: wake the MiniMax standby manager when the Claude manager runs out of quota, hand back when it is back
After=ghosty-sessions.service

[Service]
Type=simple
User=<user>
Environment=HOME=/home/<user>
ExecStart=/home/<user>/ghosty-sessions/scripts/orchestrator-failover
Restart=on-failure
RestartSec=30
Nice=10

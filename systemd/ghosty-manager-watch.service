# EXAMPLE: copy to /etc/systemd/system/ and replace every <user> and /home/<user>/ghosty-sessions with your own
# user and checkout path (see docs/INSTALL.md). Not installable as is.
[Unit]
Description=Ghosty: watchdog for the AI manager session (relaunch a dead manager, nudge one that stopped waking)
After=ghosty-sessions.service

[Service]
Type=oneshot
User=<user>
Environment=HOME=/home/<user>
# Same private settings as the dashboard unit: the relaunch path (manager-fresh.sh --now) needs AGENT_CMD_CLAUDE
# and the .env it comes from. Without this the manager command is missing and the relaunch is refused.
EnvironmentFile=-/home/<user>/ghosty-sessions/.env
ExecStart=/home/<user>/ghosty-sessions/scripts/manager-watch.sh
TimeoutStartSec=10min
Nice=10
# EXAMPLE (user unit, ~/.config/systemd/user/): replace /home/<user>/ghosty-sessions with your checkout path. Not installable as is.
# Hourly disk sweep (scripts/disk-cleanup.js --sweep, docs/DISK-CLEANUP.md): acts only when / is above 85 %, removes merged, clean,
# unused worktrees idle over 2 h (no --force). A DRY RUN until $GHOSTY_STATE_DIR/disk-cleanup.json says {"live": true}.
[Unit]
Description=Ghosty: hourly disk sweep (merged idle worktrees, only when / is above 85 %)

[Service]
Type=oneshot
ExecStart=/usr/bin/env node /home/<user>/ghosty-sessions/scripts/disk-cleanup.js --sweep --above 85 --min-age-h 2 --journal %h/.local/state/ghosty/disk-sweep-journal.md
TimeoutStartSec=30min
Nice=15
IOSchedulingClass=idle

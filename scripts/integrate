#!/bin/sh
# integrate: hand a pushed branch to the mycodebox integration lane (docs/v2/INTEGRATION-LANE.md). POSIX sh + curl; codebox and Mac.
#   integrate request [<branch>] [--repo KEY] [--deploy SCOPE] [--note TEXT] [--approved-by WHO] [--migration-applied] [--wait]   queue the branch (default: the current branch)
#                                                                                        --approved-by: manager session only; skips ONLY the infra-path floor reason (another session's claim is ignored)
#                                                                                        --migration-applied: accepted and ignored since 2026-10-21 (additive migrations need no flag); it used to attest an ADDITIVE migration's objects already exist in the target DB (Q199)
#                                                                                        --for SESSION: the wake message, the own-job watch and the pending-wake queue go to that session (a worker you
#                                                                                        queue for); the requester is told the final state too. An unknown name falls back to the requester and says so.
#   integrate status [<id>]                                                              one request, or the latest ten
#   integrate wait <id> [--timeout MIN]                                                  block until the request is final (default 60);
#                                                                                        an unreachable service is retried until the timeout
#   integrate cancel <id>                                                                only while it is still queued
#   integrate self-update                                                                fetch the current scripts/integrate + scripts/found-bug from the dashboard host (same token), verify the sha256,
#                                                                                        install into ${MYCODEBOX_BIN_DIR:-~/.local/bin} atomically (old copy kept as <name>.bak); idempotent
# Where: URL and token from ~/.config/mycodebox/config (url = ...) and ~/.config/mycodebox/token (a client added with
# `lease-token.js add <name> --integrate`), as for the Mac Stop hook; on the codebox with neither: loopback + the reporter token.
# Exit: 0 merged / deployed / CI superseded, 1 error, 3 returned (reason printed) or cancelled, 4 merged but CI red / deploy failed, 5 service unreachable.

CLIENT_SCRIPTS_VERSION=3   # bump with every change to scripts/integrate or scripts/found-bug (same number in both); the server compares it

CFG_DIR="${MYCODEBOX_CONFIG_DIR:-$HOME/.config/mycodebox}"
cfg() { [ -r "$CFG_DIR/config" ] && sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" "$CFG_DIR/config" | tail -n 1 | sed 's/[[:space:]]*$//; s/^"\(.*\)"$/\1/'; }
die() { printf 'integrate: %s\n' "$*" >&2; exit 1; }
mode_of() { if [ "$(uname -s)" = Darwin ]; then stat -f %Lp "$1" 2>/dev/null; else stat -c %a "$1" 2>/dev/null; fi; }

URL=${MYCODEBOX_URL:-$(cfg url)}
STATE_DIR="${GHOSTY_STATE_DIR:-$HOME/.local/state/ghosty}"
HDR_NAME=""; HDR_VAL=""
if [ -f "$CFG_DIR/token" ]; then
  M=$(mode_of "$CFG_DIR/token")
  case "$M" in ""|*[!0-7]*) die "cannot read the mode of $CFG_DIR/token" ;; esac
  [ "$(( 0$M & 077 ))" -eq 0 ] || die "$CFG_DIR/token must be mode 600 (it is $M)"
  HDR_NAME="Authorization"; HDR_VAL="Bearer $(tr -d '\r\n ' < "$CFG_DIR/token")"
elif [ -f "$STATE_DIR/reporter.token" ]; then
  HDR_NAME="x-ghosty-reporter-token"; HDR_VAL=$(tr -d '\r\n ' < "$STATE_DIR/reporter.token")
fi
[ -n "$URL" ] || URL="http://127.0.0.1:${PORT:-7777}"
URL=${URL%/}
case "$URL" in http://*|https://*) ;; *) die "bad url: $URL" ;; esac
[ -n "$HDR_NAME" ] || die "no token: put one in $CFG_DIR/token (see docs/MAC-HOOK.md) or run on the codebox"

TMP=$(mktemp -d "${TMPDIR:-/tmp}/integrate.XXXXXX") || die "mktemp failed"
trap 'rm -rf "$TMP"' EXIT INT TERM HUP
OUT="$TMP/out"

# api METHOD PATH [JSON]  -> body in $OUT, http code in $CODE. The token goes through curl's stdin config, never the process list.
api() {
  _m=$1; _p=$2; _d=$3
  if [ -n "$_d" ]; then
    CODE=$(printf 'header = "%s: %s"\nheader = "content-type: application/json"\n' "$HDR_NAME" "$HDR_VAL" | curl -sS -K - -X "$_m" --data-binary "$_d" -o "$OUT" -w '%{http_code}' --max-time 60 "$URL$_p" 2>"$TMP/err")
  else
    CODE=$(printf 'header = "%s: %s"\n' "$HDR_NAME" "$HDR_VAL" | curl -sS -K - -X "$_m" -o "$OUT" -w '%{http_code}' --max-time 60 "$URL$_p" 2>"$TMP/err")
  fi
  _rc=$?
  UNREACHABLE=0
  if [ "$_rc" -ne 0 ] || [ "$CODE" = "000" ]; then
    UNREACHABLE=1
    # SOFT=1 (wait): the caller retries; a restart of the service (a self-deploy) must not end the wait
    [ "${SOFT:-0}" = 1 ] && return 0
    printf 'integrate: service unreachable at %s (%s)\n' "$URL" "$(head -n 1 "$TMP/err")" >&2; exit 5
  fi
}
val() { sed -n "s/^$1=//p" "$OUT" | head -n 1; }
tail_of() { sed -n '/^---$/,$p' "$OUT" | sed 1d; }
fail_http() { _e=$(val error); [ -n "$_e" ] || _e="HTTP $CODE"; printf 'integrate: %s\n' "$_e" >&2; exit 1; }
json_esc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g' | tr -d '\000-\037'; }
urlenc() { printf '%s' "$1" | sed 's/%/%25/g; s/ /%20/g; s/&/%26/g; s/?/%3F/g; s/#/%23/g'; }

# sha256 of a file (Linux sha256sum, macOS shasum, else openssl)
sha_of() { if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | cut -d' ' -f1; elif command -v shasum >/dev/null 2>&1; then shasum -a 256 "$1" | cut -d' ' -f1; else openssl dgst -sha256 "$1" | sed 's/^.*= *//'; fi; }

# integrate self-update: both client scripts from the dashboard host. Never installs a file whose sha256 differs from the manifest.
self_update() {
  _bin=${MYCODEBOX_BIN_DIR:-$HOME/.local/bin}
  api GET "/api/integration/client-scripts?format=kv"; [ "$CODE" = 200 ] || fail_http
  cp "$OUT" "$TMP/manifest"; _ver=$(sed -n 's/^version=//p' "$TMP/manifest" | head -n 1); _chg=0
  mkdir -p "$_bin" || die "cannot create $_bin"
  for _n in integrate found-bug; do
    _want=$(sed -n "s/^$_n\\.sha256=//p" "$TMP/manifest" | head -n 1); [ -n "$_want" ] || die "the server did not list $_n"
    if [ -f "$_bin/$_n" ] && [ "$(sha_of "$_bin/$_n")" = "$_want" ]; then printf '%s is current\n' "$_n"; continue; fi
    api GET "/api/integration/client-scripts/$_n"; [ "$CODE" = 200 ] || fail_http
    cp "$OUT" "$TMP/$_n.new" || die "cannot stage $_n"
    [ "$(sha_of "$TMP/$_n.new")" = "$_want" ] || die "checksum mismatch for $_n: nothing installed"
    [ -f "$_bin/$_n" ] && cp -p "$_bin/$_n" "$_bin/$_n.bak"
    cp "$TMP/$_n.new" "$_bin/.$_n.new.$$" && chmod 755 "$_bin/.$_n.new.$$" && mv -f "$_bin/.$_n.new.$$" "$_bin/$_n" || { rm -f "$_bin/.$_n.new.$$"; die "cannot install $_n into $_bin"; }
    printf 'updated %s in %s (previous copy: %s.bak)\n' "$_n" "$_bin" "$_n"; _chg=1
  done
  [ "$_chg" = 1 ] || printf 'client scripts are current (version %s)\n' "$_ver"
  case ":$PATH:" in *":$_bin:"*) ;; *) printf 'note: %s is not on PATH\n' "$_bin" ;; esac
}

# Print a request's outcome and exit with its code.
report() {
  _state=$(val state); _text=$(val text); _reason=$(val reason); _exit=$(val exit)
  printf '%s\n' "$_text"
  case "$_state" in
    returned|merged_ci_red|deploy_failed)
      _t=$(tail_of); [ -n "$_t" ] && printf '%s\n' "$_t"
      case "$_state" in returned) if [ "$(val outcome)" = needs_approval ]; then printf 'Waiting for the manager: a manager item was created; it approves with integrate request <branch> --approved-by manager.\n'; else printf 'Fix it on your branch, push it and run integrate request again.\n'; fi ;; *) printf 'The merge is on the target; the manager decides what happens next. Do not revert it yourself.\n' ;; esac ;;
  esac
  [ -n "$_exit" ] || exit 1
  exit "$_exit"
}

do_wait() {   # do_wait ID MINUTES
  _id=$1; _min=$2; _end=$(( $(date +%s) + _min * 60 ))
  _down=0
  while :; do
    SOFT=1; api GET "/api/integration/requests/$_id/wait?timeout=25&format=kv"; SOFT=0
    if [ "$UNREACHABLE" = 1 ]; then
      if [ "$(date +%s)" -ge "$_end" ]; then printf 'integrate: service unreachable at %s (%s)\n' "$URL" "$(head -n 1 "$TMP/err")" >&2; exit 5; fi
      [ "$_down" = 1 ] || printf 'integrate: service unreachable at %s, retrying until the timeout\n' "$URL" >&2
      _down=1; sleep "${INTEGRATE_RETRY_SEC:-5}"; continue
    fi
    _down=0
    [ "$CODE" = 200 ] || fail_http
    [ "$(val final)" = true ] && report
    [ "$(date +%s)" -lt "$_end" ] || { printf 'integrate: still %s after %s min (integrate wait %s to keep waiting)\n' "$(val state)" "$_min" "$_id" >&2; exit 1; }
  done
}

cmd=$1; [ $# -gt 0 ] && shift
case "$cmd" in
  request)
    BRANCH=""; REPO=""; DEPLOY=""; NOTE=""; APPROVER=""; MIGAPPLIED=0; WAIT=0; FOR=""; MAC=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --repo) REPO=$2; shift 2 ;; --deploy) DEPLOY=$2; shift 2 ;; --note) NOTE=$2; shift 2 ;; --approved-by) APPROVER=$2; shift 2 ;; --migration-applied) MIGAPPLIED=1; shift ;; --wait) WAIT=1; shift ;; --for) FOR=$2; shift 2 ;; --mac) MAC=$2; shift 2 ;;
        -*) die "unknown option $1" ;; *) BRANCH=$1; shift ;;
      esac
    done
    [ -n "$BRANCH" ] || BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
    case "$BRANCH" in ""|HEAD) die "name the branch: integrate request <branch>" ;; esac
    SESSION=${MYCODEBOX_SESSION:-}
    [ -n "$SESSION" ] || { [ -n "$TMUX" ] && SESSION=$(tmux display-message -p '#S' 2>/dev/null); }
    # on the Mac the tmux name is a Mac session: the server only accepts `mac:`-prefixed names from a remote client
    case "$SESSION" in ""|mac:*) ;; *) [ "$(uname -s)" = Darwin ] && SESSION="mac:$SESSION" ;; esac
    # a Mac request is always external: label it with the session name (or "mac") unless --mac says otherwise
    [ -n "$MAC" ] || { [ "$(uname -s)" = Darwin ] && MAC=${SESSION:-mac}; }
    ORIGIN=$(git remote get-url origin 2>/dev/null)
    BODY="{\"branch\":\"$(json_esc "$BRANCH")\",\"cwd\":\"$(json_esc "$PWD")\""
    WT=$(git rev-parse --show-toplevel 2>/dev/null) && [ -n "$WT" ] && BODY="$BODY,\"worktree\":\"$(json_esc "$WT")\""
    [ -n "$REPO" ] && BODY="$BODY,\"repo\":\"$(json_esc "$REPO")\""
    [ -n "$DEPLOY" ] && BODY="$BODY,\"deploy\":\"$(json_esc "$DEPLOY")\""
    [ -n "$FOR" ] && BODY="$BODY,\"forSession\":\"$(json_esc "$FOR")\""
    [ -n "$MAC" ] && BODY="$BODY,\"mac\":\"$(json_esc "$MAC")\""
    [ -n "$NOTE" ] && BODY="$BODY,\"note\":\"$(json_esc "$NOTE")\""
    [ -n "$APPROVER" ] && BODY="$BODY,\"approvedBy\":\"$(json_esc "$APPROVER")\""
    [ "$MIGAPPLIED" = 1 ] && [ -n "$APPROVER" ] && BODY="$BODY,\"migrationApplied\":true"
    [ -n "$SESSION" ] && BODY="$BODY,\"session\":\"$(json_esc "$SESSION")\""
    [ -n "$ORIGIN" ] && BODY="$BODY,\"origin\":\"$(json_esc "$ORIGIN")\""
    BODY="$BODY}"
    api POST "/api/integration/requests?format=kv" "$BODY"
    [ "$CODE" = 200 ] || fail_http
    ID=$(val id)
    if [ "$(val coalesced)" = 1 ]; then
      printf 'Integration %s updated (coalesced with the queued request)\n' "$ID"
    else
      printf 'Integration %s queued for %s (position %s).\n' "$ID" "$(val repo)" "$(val position)"
    fi
    [ -n "$(val forSession)" ] && printf 'The result goes to %s (and to you).\n' "$(val forSession)"
    _fn=$(val forNote); [ -n "$_fn" ] && printf '%s\n' "$_fn"
    if [ "$(val approvalIgnored)" = 1 ]; then
      printf 'approval ignored: only the manager can approve\n'
      printf 'The request is queued without an approval; a floor that needed it will return it.\n'
    fi
    # drift: the lane tells us the current client-script version; one line, never blocking
    _sv=$(val clientScripts); case "$_sv" in ""|*[!0-9]*) ;; *) [ "$_sv" -gt "$CLIENT_SCRIPTS_VERSION" ] && printf 'client scripts are old (v%s, server v%s): run integrate self-update\n' "$CLIENT_SCRIPTS_VERSION" "$_sv" ;; esac
    command -v found-bug >/dev/null 2>&1 || printf 'found-bug is not installed here: run integrate self-update (then found-bug --help)\n'
    if [ "$WAIT" = 1 ]; then do_wait "$ID" 60; fi
    printf 'Integration %s queued. Keep working on anything that does not depend on it; end the turn with STATUS: waiting: integration %s only when nothing else is left.\n' "$ID" "$ID" ;;
  status)
    if [ -n "$1" ]; then
      api GET "/api/integration/requests/$(urlenc "$1")?format=kv"; [ "$CODE" = 200 ] || fail_http
      printf '%s\n' "$(val text)"; _r=$(val reason); [ -n "$_r" ] && printf 'reason: %s\n' "$_r"; _tl=$(val timeline); [ -n "$_tl" ] && printf 'timeline: %s\n' "$_tl"; tail_of
    else
      api GET "/api/integration/requests?limit=10&format=kv"; [ "$CODE" = 200 ] || fail_http
      tail_of
    fi ;;
  wait)
    ID=$1; [ -n "$ID" ] || die "usage: integrate wait <id> [--timeout min]"; shift
    MIN=60
    while [ $# -gt 0 ]; do case "$1" in --timeout) MIN=$2; shift 2 ;; *) die "unknown option $1" ;; esac; done
    case "$MIN" in ""|*[!0-9]*) die "--timeout is in whole minutes" ;; esac
    do_wait "$ID" "$MIN" ;;
  cancel)
    [ -n "$1" ] || die "usage: integrate cancel <id>"
    api POST "/api/integration/requests/$(urlenc "$1")/cancel?format=kv" "{}"; [ "$CODE" = 200 ] || fail_http
    printf '%s\n' "$(val text)" ;;
  self-update) self_update ;;
  ack)
    [ -n "$1" ] || die "usage: integrate ack <id>   (manager: the external result was relayed)"
    api POST "/api/integration/external-results/$(urlenc "$1")/ack?format=kv" "{}"; [ "$CODE" = 200 ] || fail_http
    printf 'Integration %s external result acknowledged.\n' "$1" ;;
  *) printf 'usage: integrate request [<branch>] [--repo KEY] [--deploy SCOPE] [--note TEXT] [--approved-by WHO] [--migration-applied] [--wait] [--for SESSION] [--mac LABEL] | ack <id> | status [<id>] | wait <id> [--timeout MIN] | cancel <id> | self-update\n' >&2; exit 1 ;;
esac

#!/usr/bin/env bash
# cloud-start: start one Claude Code cloud session (Anthropic-hosted VM) from codebox and print its URL. docs/CLOUD.md.
#   cloud-start -C <repo checkout> [-l <label>] [-m <model>, default sonnet] (-t "task" | -f task-file)
# The VM clones the checkout's GitHub remote at its CURRENT BRANCH as pushed (not local changes): push it first.
# Creating a cloud session is interactive only (CLI 2.1.332: "--cloud cannot be combined with --print"), so
# `claude --cloud` runs in a detached tmux on a private socket (no dashboard card); we read its "View:" line and close it.
# The session keeps running in the cloud. Each start is one line in $GHOSTY_STATE_DIR/cloud-sessions.jsonl.
# Follow-up message to a running session: claude -p "<text>" --cloud <session-id>
set -euo pipefail
usage() { sed -n '2,3p' "$0" | sed 's/^# //' >&2; exit 2; }
DIR=. LABEL= TASK= FILE= MODEL=sonnet
while getopts "C:l:m:t:f:h" o; do
  case $o in C) DIR=$OPTARG ;; l) LABEL=$OPTARG ;; m) MODEL=$OPTARG ;; t) TASK=$OPTARG ;; f) FILE=$OPTARG ;; *) usage ;; esac
done
[ -n "$FILE" ] && TASK=$(cat "$FILE")
[ -n "$TASK" ] || usage
# The model goes into the tmux command line below: ids and aliases only.
[[ $MODEL =~ ^[A-Za-z0-9._-]+$ ]] || { echo "cloud-start: bad model name" >&2; exit 2; }
# The label becomes the lane's --mac cloud-<label>: same charset. A task starting with - would be read as a claude option.
[ -z "$LABEL" ] || [[ $LABEL =~ ^[A-Za-z0-9._-]{1,50}$ ]] || { echo "cloud-start: label: letters, digits, . _ - only (max 50)" >&2; exit 2; }
[[ $TASK != -* ]] || { echo "cloud-start: the task must not start with -" >&2; exit 2; }
cd "$DIR"
BR=$(git rev-parse --abbrev-ref HEAD)
REM=$(git ls-remote origin "refs/heads/$BR" | cut -f1)
[ "$REM" = "$(git rev-parse HEAD)" ] || { echo "cloud-start: $BR is not pushed as is (origin ${REM:-none}): git push -u origin $BR first" >&2; exit 1; }
STATE=${GHOSTY_STATE_DIR:-$HOME/.local/state/ghosty}
tmp=$(mktemp -d); trap 'rm -rf "$tmp"; tmux -L cloud-start kill-session -t "$name" 2>/dev/null || true' EXIT
printf '%s' "$TASK" > "$tmp/task"
name=cs-$$
tmux -L cloud-start new-session -d -s "$name" -x 220 -y 50 -c "$PWD" "claude --model $MODEL --cloud \"\$(cat '$tmp/task')\"; sleep 30"
url=
for _ in $(seq 1 60); do
  url=$(tmux -L cloud-start capture-pane -p -t "$name" 2>/dev/null | tr -d '\n' | grep -o 'https://claude.ai/code/session_[A-Za-z0-9]*' | head -n 1) || true
  [ -n "$url" ] && break; sleep 2
done
[ -n "$url" ] || { echo "cloud-start: no session URL after 120 s; the pane said:" >&2; tmux -L cloud-start capture-pane -p -t "$name" >&2 || true; exit 1; }
id=${url##*/}
repo=$(basename "$(git remote get-url origin)" .git)
mkdir -p "$STATE"
# One JSON line, encoded by node (every field escaped); the file is private to the user (umask 077 on creation).
(umask 077; AT=$(date -u +%FT%TZ) ID=$id URL=$url REPO=$repo BASE=$BR LABEL=${LABEL:-$id} \
  BY=${MYCODEBOX_SESSION:-$(tmux display-message -p '#S' 2>/dev/null || echo cli)} TASK1=$(printf '%s' "$TASK" | head -n 1 | cut -c1-160) \
  node -e 'const e=process.env; console.log(JSON.stringify({at:e.AT,id:e.ID,url:e.URL,repo:e.REPO,base:e.BASE,label:e.LABEL,by:e.BY,task:e.TASK1}))' \
  >> "$STATE/cloud-sessions.jsonl"; chmod 600 "$STATE/cloud-sessions.jsonl")
echo "$url"

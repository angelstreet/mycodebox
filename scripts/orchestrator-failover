#!/usr/bin/env bash
# orchestrator-failover — keeps the manager role alive when the Claude manager runs out of quota (name kept for old references).
# Every POLL seconds: if Claude is limited (5 h or weekly quota >= LIMIT_PCT, or the manager pane shows a usage-limit
# message), start or wake the MiniMax standby `mm-manager` with a standby message; when Claude is back under BACK_PCT,
# ask the standby for a handback note and tell the Claude manager to read it. Both agents log to LOG.
# The standby is only promoted when its OWN windows still have headroom: handing the manager role to a seat that is out of
# quota too leaves nobody managing. A missing, unreadable or stale quota file means "unknown", for Claude and for the
# standby: no action. A window left out of a reading means no limit is in effect for it: 0 % used.
# Hard floors stay owner-only for the standby too.
#   --once   one pass, then exit      --dry   print what would happen; touches no tmux session, writes no state or log
set -u
POLL=${POLL:-300}; LIMIT_PCT=${LIMIT_PCT:-97}; BACK_PCT=${BACK_PCT:-90}
STALE_RL_S=${STALE_RL_S:-1800}          # quota reading older than this is unknown
STALE_STATE_H=${STALE_STATE_H:-12}      # a "minimax" state older than this, with Claude fine, is a leftover: reset silently
SD=${GHOSTY_STATE_DIR:-$HOME/.local/state/ghosty}
RL=${FAILOVER_RL:-$SD/claude-rate-limits.json}
MRL=${FAILOVER_STANDBY_RL:-$SD/minimax-rate-limits.json}   # the standby's own windows (quota.js writes it); the gate for promotion
LOG=${FAILOVER_LOG:-$HOME/handovers/notes/orchestrator-log.md}
STATE=${FAILOVER_STATE:-$HOME/handovers/notes/.failover-state}   # "claude" or "minimax"
MANAGER=${FAILOVER_MANAGER:-manager}; STANDBY=${FAILOVER_STANDBY:-mm-manager}
STANDBY_BRIEF=${FAILOVER_STANDBY_BRIEF:-$SD/briefs/mm-manager.txt}
MANUAL=${FAILOVER_MANUAL:-$HOME/vpt-manager/docs/tasks/TASK-44-MANAGER.md}
ENSURE=${FAILOVER_ENSURE:-$HOME/bin/ensure-mm-manager-tmux.sh}
ONCE=0; DRY=0
for a in "$@"; do case "$a" in --once) ONCE=1;; --dry) DRY=1; ONCE=1;; *) echo "usage: $0 [--once] [--dry]" >&2; exit 2;; esac; done

note() { echo "$(date -u '+%F %H:%M') $*"; [ "$DRY" = 1 ] || { mkdir -p "$(dirname "$LOG")"; echo "- $(date -u '+%F %H:%M') failover: $*" >> "$LOG"; }; }
say() { tmux send-keys -t "=$1:0" -l "$2" && sleep 1 && tmux send-keys -t "=$1:0" C-m; }
busy() { tmux capture-pane -p -t "=$1:0" 2>/dev/null | tail -8 | grep -q -i "esc to interrupt"; }  # never type into a working session
setstate() { [ "$DRY" = 1 ] || { mkdir -p "$(dirname "$STATE")"; echo "$1" > "$STATE.tmp.$$" && mv -f "$STATE.tmp.$$" "$STATE"; }; }   # atomic: a reader never sees a half-written state

quota() {  # $1 file to read (default: Claude's); prints "<5h%> <week%> <reset epoch>" or "? ? ?" (missing, unreadable or stale file)
  python3 - "${1:-$RL}" "$STALE_RL_S" "$LIMIT_PCT" <<'PY' 2>/dev/null || echo "? ? ?"
import json,sys,time
p,stale,lim=sys.argv[1],int(sys.argv[2]),int(sys.argv[3])
j=json.load(open(p)); d=j["rate_limits"]
at=j.get("at") or 0
at=at/1000 if at>1e11 else at
if not at or time.time()-at>stale: raise SystemExit(1)
def win(k):
    # Claude Code omits a window when no limit is in effect for it (the weekly one right after its reset):
    # an absent window is 0 % used with no reset time, not a broken reading. A window that is there but
    # malformed still reads as unknown.
    v=d.get(k)
    return (0,0) if v is None else (int(v["used_percentage"]), v.get("resets_at") or 0)
(h,r1),(wk,r2)=win("five_hour"),win("seven_day")
r=max(r1 if h>=lim else 0, r2 if wk>=lim else 0)
print(h,wk,int(r))
PY
}

standby_msg() {  # $1 5h  $2 week  $3 resets
  echo "STANDBY MODE: the Claude manager (tmux session ${MANAGER}) is out of quota (5h ${1}%, week ${2}%, resets ${3}). You are now the acting manager. Ignore the 'standby orchestrator' paragraph in your brief and ~/handovers/orchestrator.brief.md (old role); follow ${MANUAL} (authority, loop, decision table, escalation): wake on events via scripts/manager-wait.sh plus an hourly sweep. Same limits as the Claude manager: hard floors (deploys, merges to main, deletions, credentials, money, customers, sudoers/units, force-push, destructive migrations) stay owner-only; merges and pushes go through the integration lane. Never type into a working session, never send Esc or Ctrl-C. Append every action as one line to ${LOG}. When you are told Claude is back, write a handback summary to that log and stop."
}

pass() {
  local H W RESET cur limited=0 back=0 pane_limited=0 resets SH SW
  read -r H W RESET <<<"$(quota)"
  [ -f "$STATE" ] && cur=$(cat "$STATE") || cur=claude
  [ "$cur" = minimax ] || cur=claude
  if [ "$H" = "?" ]; then echo "$(date -u '+%F %H:%M') quota unknown (missing or stale ${RL##*/}): no action (state $cur)"; return; fi
  if [ "$DRY" = 0 ]; then
    tmux capture-pane -p -t "=${MANAGER}:0" 2>/dev/null | tail -15 | grep -q -i -E "usage limit reached|you've hit your .*limit|out of (extra )?usage" && pane_limited=1
  fi
  { [ "$H" -ge "$LIMIT_PCT" ] || [ "$W" -ge "$LIMIT_PCT" ] || [ "$pane_limited" = 1 ]; } && limited=1
  [ "$H" -lt "$BACK_PCT" ] && [ "$W" -lt "$BACK_PCT" ] && [ "$pane_limited" = 0 ] && back=1
  # a stale "minimax" (set long ago, e.g. before a restart) is a leftover: back to claude, no handback; if still limited the next pass takes over
  # ...unless the standby pane shows it is still working: then it is not a leftover, and a reset would promote it a second time
  if [ "$cur" = minimax ] && [ -f "$STATE" ] && [ $(( $(date +%s) - $(stat -c %Y "$STATE") )) -gt $((STALE_STATE_H*3600)) ]; then
    if [ "$DRY" = 0 ] && busy "$STANDBY"; then
      touch "$STATE"; note "state was minimax for over ${STALE_STATE_H}h but ${STANDBY} is still working: kept minimax"
    else
      setstate claude; cur=claude; note "state was minimax for over ${STALE_STATE_H}h (5h ${H}%, week ${W}%): reset to claude, no handback"
    fi
  fi
  if [ "$limited" = 1 ] && [ "$cur" = claude ]; then
    # the standby must have somewhere to go: Claude being out of quota says nothing about MiniMax. Unknown is not healthy.
    read -r SH SW _ <<<"$(quota "$MRL")"
    if [ "$SH" = "?" ]; then
      note "Claude limited (5h ${H}%, week ${W}%) but ${STANDBY} quota unknown (missing or stale ${MRL##*/}): not promoting; retry next poll"; return
    fi
    if [ "$SH" -ge "$LIMIT_PCT" ] || [ "$SW" -ge "$LIMIT_PCT" ]; then
      note "Claude limited (5h ${H}%, week ${W}%) and ${STANDBY} is out of quota too (5h ${SH}%, week ${SW}%): no seat left to hand over to; operator needed"; return
    fi
    resets=$([ "${RESET:-0}" -gt 0 ] && date -u -d "@$RESET" '+%F %H:%M UTC' || echo unknown)
    if [ "$DRY" = 1 ]; then note "DRY: would start/wake ${STANDBY} and send the standby message (5h ${H}%, week ${W}%, resets ${resets}); state claude -> minimax (${STANDBY} at 5h ${SH}%, week ${SW}%)"; standby_msg "$H" "$W" "$resets"; return; fi
    if ! tmux has-session -t "=${STANDBY}" 2>/dev/null; then
      "$ENSURE" >/dev/null 2>&1; sleep 20
      [ -f "$STANDBY_BRIEF" ] && { tmux load-buffer -b mmbrief "$STANDBY_BRIEF"; tmux paste-buffer -b mmbrief -t "${STANDBY}" -d; sleep 2; tmux send-keys -t "${STANDBY}" C-m; sleep 60; }
    fi
    if ! tmux has-session -t "=${STANDBY}" 2>/dev/null; then note "Claude limited but ${STANDBY} could not be started: retry next poll"; return; fi
    if busy "$STANDBY"; then echo "$(date -u '+%F %H:%M') ${STANDBY} is working: standby message deferred"; return; fi
    say "$STANDBY" "$(standby_msg "$H" "$W" "$resets")"
    setstate minimax; note "Claude limited (5h ${H}%, week ${W}%, pane ${pane_limited}) -> ${STANDBY} standby active (${STANDBY} at 5h ${SH}%, week ${SW}%)"
  elif [ "$back" = 1 ] && [ "$cur" = minimax ]; then
    if [ "$DRY" = 1 ]; then note "DRY: would ask ${STANDBY} for a handback note and tell ${MANAGER} to read it (5h ${H}%, week ${W}%); state minimax -> claude"; return; fi
    if tmux has-session -t "=${STANDBY}" 2>/dev/null && ! busy "$STANDBY"; then
      say "$STANDBY" "Claude is back. Write a handback summary to ${LOG} (what you merged, restarted, answered, started, and anything pending), then return to your normal role. Do not act as manager any more."
      sleep 120
    fi
    if tmux has-session -t "=${MANAGER}" 2>/dev/null; then
      busy "$MANAGER" && { echo "$(date -u '+%F %H:%M') ${MANAGER} is working: handback message deferred"; return; }
      say "$MANAGER" "${STANDBY} (MiniMax) acted as manager while you were out of quota. Read the last entries of ${LOG}, then continue your loop from there."
    fi
    setstate claude; note "Claude back (5h ${H}%, week ${W}%) -> handback to ${MANAGER}"
  else
    echo "$(date -u '+%F %H:%M') no action (5h ${H}%, week ${W}%, state ${cur})"
  fi
}

# one watcher per state file: a second instance (duplicated unit, overlapping restart) would promote the standby twice
if [ "$DRY" = 0 ]; then
  mkdir -p "$(dirname "$STATE")"
  exec 9>"$STATE.lock"
  flock -n 9 || { echo "$(date -u '+%F %H:%M') another watcher holds ${STATE}.lock: exiting"; exit 0; }
fi
[ "$DRY" = 1 ] || { [ -f "$STATE" ] || { mkdir -p "$(dirname "$STATE")"; echo claude > "$STATE"; }; }
[ "$ONCE" = 1 ] || note "watcher started (poll ${POLL}s, limit ${LIMIT_PCT}%, back ${BACK_PCT}%)"
while true; do
  pass
  [ "$ONCE" = 1 ] && exit 0
  sleep "$POLL"
done

#!/usr/bin/env bash
# cbsession — start an AI agent session in tmux on this host (shows on the mycodebox dashboard).
# Claude sessions always get Remote Control, so they also appear in the Claude app / claude.ai.
#
#   cbsession -n NAME -d DIR [-p claude|codex|minimax|opencode] [-m MODEL] [-b BILLING] (-H HANDOVER | -f PROMPT_FILE | -t "TEXT")
#
#   -n  tmux session name (A-Z a-z 0-9 _ -, max 40); also the Remote Control name
#   -d  working directory on this host (repo checkout)
#   -p  provider (default claude)
#   -m  model: claude haiku|sonnet|opus|fable|<id>; codex <model>; minimax MiniMax-M3 (default; the only MiniMax model, owner decision 2026-10-14);
#       opencode <provider/model>
#   -b  claude billing: sub (default, the Max plan login) or NAME = the API key in ~/.config/anthropic/NAME.key
#       (one line, chmod 600; read at launch by apiKeyHelper, never copied). NAME.workspace, if present, holds the
#       workspace id a user key (sk-ant-usr) needs. ANTHROPIC_API_KEY from the environment is always dropped.
#       Note: the API refuses interactive Claude Code (entrypoint cli) on credit that excludes it ("Credit balance too
#       low") while claude -p on the same key works: run API-key agents headless with claude -p.
#   -H  handover file: the session reads it, summarises state and open items, then does the work (owner autonomy rule)
#   -W  with -H: review only — summarise, propose the next step, then wait for the owner
#   -f  prompt file, used verbatim;  -t  prompt text
#   -g  the task goal, one line: written as `Goal: ...` under the preamble; the done-check compares the closing STATUS with it
#       (status-honesty.js goalOf; without -g the first task line of the prompt is the goal)
#   -D  a Done-when line (repeatable, 1 to 5; numbered in order): checkable by something other than the session. Without -D the brief's `Done when:` lines are used;
#       none at all = start refused (exit 2), except a -t one-liner or -A (an auto line + warning)
#   -T  time box, e.g. "2 h" / "90 min" (else the brief's `Time box:`, else 2 h for a fix / bug* name, 6 h for a feature)
#   -A  automation start (lane, bug-drain, nightly): accept a prompt without Done-when lines, with an auto line
#   -w  worktree branch (default <type>/<name>: fix/ for BUG*, docs/ for docs*, else feat/; name lowercased)
#   -N  no worktree: start in DIR itself
#   -x  dry run: print the launch command (and the worktree step), start nothing
# Worktree (before the first prompt): when DIR is the main checkout of a git repo (not a linked worktree) and is not
#   listed in ~/.config/cbsession/no-worktree (one path per line: live checkouts of services), cbsession runs
#   `git worktree add ~/<repo>-<name> -b <branch> main` (origin/main when it exists) and starts the session there.
#   An existing ~/<repo>-<name> worktree, or an existing branch, is reused (idempotent).
# Env: MCODE_NODE_DIR (node bin dir for mcode), GHOSTY_STATE_DIR, GHOSTY_PORT (default $PORT or 7777) (to report the start to the dashboard history).
set -euo pipefail
q() { printf '%q' "$1"; }
NAME= DIR= PROV=claude MODEL= BILL=sub HANDOVER= PFILE= TEXT= DRY=0 WAIT=0 WTB= NOWT=0 GOAL= TIMEBOX= AUTOMATION=0 DONEWHEN=()
while getopts "n:d:p:m:b:H:f:t:w:g:D:T:ANxWh" o; do case $o in
  n) NAME=$OPTARG;; d) DIR=$OPTARG;; p) PROV=$OPTARG;; m) MODEL=$OPTARG;; b) BILL=$OPTARG;; H) HANDOVER=$OPTARG;;
  f) PFILE=$OPTARG;; t) TEXT=$OPTARG;; w) WTB=$OPTARG;; N) NOWT=1;; x) DRY=1;; W) WAIT=1;; g) GOAL=$OPTARG;; D) DONEWHEN+=("$OPTARG");; T) TIMEBOX=$OPTARG;; A) AUTOMATION=1;; *) sed -n 2,40p "$0"; exit 2;; esac; done
[[ $NAME =~ ^[A-Za-z0-9_-]{1,40}$ ]] || { echo "cbsession: -n NAME required (A-Z a-z 0-9 _ -, max 40)" >&2; exit 2; }
[ -d "$DIR" ] || { echo "cbsession: -d DIR must be an existing directory" >&2; exit 2; }
DIR=$(cd "$DIR" && pwd)
[[ $BILL =~ ^[A-Za-z0-9_-]{1,40}$ ]] || { echo "cbsession: -b BILLING must be sub or a key name (A-Z a-z 0-9 _ -)" >&2; exit 2; }
KF="$HOME/.config/anthropic/$BILL.key"
if [ "$BILL" != sub ]; then
  [ "$PROV" = claude ] || { echo "cbsession: -b applies to -p claude only" >&2; exit 2; }
  [ -s "$KF" ] || { echo "cbsession: billing key $KF not found (one line, chmod 600)" >&2; exit 2; }
fi
tmux has-session -t "=$NAME" 2>/dev/null && { echo "cbsession: tmux session '$NAME' already exists" >&2; exit 1; }

# Own worktree before the first prompt (see header). Sets DIR to the worktree; WTCMD is what the dry run prints.
WTCMD=
TOP=$(git -C "$DIR" rev-parse --show-toplevel 2>/dev/null || true)
if [ "$NOWT" != 1 ] && [ -n "$TOP" ] \
   && [ "$(git -C "$TOP" rev-parse --absolute-git-dir)" = "$(git -C "$TOP" rev-parse --path-format=absolute --git-common-dir)" ] \
   && ! { [ -r "$HOME/.config/cbsession/no-worktree" ] && grep -qxF "$TOP" "$HOME/.config/cbsession/no-worktree"; }; then
  if [ -z "$WTB" ]; then
    LN=$(tr '[:upper:]' '[:lower:]' <<<"$NAME")
    case $LN in bug*) WTB=fix/$LN;; docs*) WTB=docs/$LN;; *) WTB=feat/$LN;; esac
  fi
  WT="$HOME/$(basename "$TOP")-$NAME"; SUB=${DIR#"$TOP"}
  BASE=main; git -C "$TOP" rev-parse --verify -q origin/main >/dev/null && BASE=origin/main
  if [ -d "$WT" ]; then WTCMD="reuse $WT"
  elif git -C "$TOP" rev-parse --verify -q "refs/heads/$WTB" >/dev/null; then WTCMD="git -C $(q "$TOP") worktree add $(q "$WT") $(q "$WTB")"
  else WTCMD="git -C $(q "$TOP") worktree add $(q "$WT") -b $(q "$WTB") $BASE"; fi
  if [ "$DRY" != 1 ] && [ "${WTCMD%% *}" = git ]; then
    eval "$WTCMD" >/dev/null 2>&1 || { echo "cbsession: could not create the worktree: $WTCMD" >&2; exit 1; }
    # A fresh worktree has no node_modules, so `npm test` fails until `npm ci` is run by hand (bug-222245ca): link the
    # checkout's own install (one runtime dependency, read-only use), else install from the lockfile.
    if [ -f "$WT/package-lock.json" ] && [ ! -e "$WT/node_modules" ]; then
      if [ -d "$TOP/node_modules" ]; then ln -s "$TOP/node_modules" "$WT/node_modules"
      else (cd "$WT" && npm ci --ignore-scripts --no-audit --no-fund >/dev/null 2>&1) || true; fi
    fi
  fi
  [ -d "$WT" ] && git -C "$WT" rev-parse --git-dir >/dev/null 2>&1 || [ "$DRY" = 1 ] \
    || { echo "cbsession: $WT exists but is not a git worktree" >&2; exit 1; }
  DIR=$WT$SUB
  # Daily sessions (<game>-daily-<YYYYMMDD>): keep the newest 3 worktrees per game; clean, merged, unused ones only (owner 2026-11-10).
  case $NAME in *-daily-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]) [ "$DRY" = 1 ] || node "$(dirname "$(readlink -f "$0")")/prune-daily-worktrees.js" "$TOP" "$NAME" >&2 || true;; esac
fi

H="$HOME/handovers"; mkdir -p "$H"; P="$H/$NAME.prompt.md"; L="$H/$NAME.launch.sh"
if [ -n "$HANDOVER" ]; then
  [ -f "$HANDOVER" ] || { echo "cbsession: handover $HANDOVER not found on this host (scp it to ~/handovers/ first)" >&2; exit 2; }
  HANDOVER=$(cd "$(dirname "$HANDOVER")" && pwd)/$(basename "$HANDOVER")
  # Unquoted heredoc (it must interpolate $DIR/$HANDOVER): every ` ... ` is a command substitution unless escaped,
  # which silently ran the integration commands and emptied them out of the prompt (2026-10-20).
  cat > "$P" <<EOF
You are picking up work in a fresh session on this host. Working directory: $DIR.
Ship rule (owner 2026-11-11): after a change run the touched tests/typecheck yourself, commit, push your branch, \`integrate request <branch> [--deploy ...]\`; never ask permission for these and never end a turn with an offer ("I can ...", "if you want", "should I", "nothing is committed") for something the rules already authorise; verify UI yourself with headless Playwright (skill vpt-headless-verify); end with a STATUS line.
0. First command: \`git worktree list\`; create or reuse your worktree (\`git worktree add <dir> -b <branch> origin/main\`) and
   work only there, never in a shared checkout (~/ghosty-sessions, ~/virtualpytest): a guard reports edits made there.
1. Read the handover: $HANDOVER, then the files it links as needed.
2. Write a short summary of the current state and the open items in priority order.
3. Then do the work, most important item first, and keep going until it is done or truly blocked. Owner rule
   (2026-10-14, ship rule 2026-11-11): never stop to ask to start a plan you wrote, pick your recommended option, ship
   your own tested work (commit, push your branch, \`integrate request\`: the lane merges, pushes the target and deploys),
   or rerun a test; do it and report it. Corrections come at the end. Make a git worktree before changing code in a shared checkout, and claim a lease
   before using a shared host or device; hold it only while you actively control it, never while you wait. Never wait
   on a named host or device while an equivalent one is free: use \`vpt-lease claim <env> --any <group> --wait\` (groups:
   \`vpt-lease inventory <env>\`) or the free one by name; only unique hardware is worth a queue (docs/LEASE-RULES.md).
   Use \`--any <group>\`, never wait on a named device while \`vpt-lease list\` shows a free-equivalent: a
   \`STATUS: waiting: lease\` with a healthy free equivalent is refused and you are sent back to claim it.
   Run long jobs (runs, suites, builds, deploys) in the foreground of a background shell the harness tracks, so you
   are woken when they end; never nohup, setsid, disown or a trailing & (the harness cannot see those). If you must
   wait on a job anyway, name its pid, log file, run id or deploy id in the STATUS line (STATUS: waiting: run r-12,
   pid 4242, log /tmp/run.log): the manager then wakes you when it ends. Waiting on your own job is not "blocked".
   Integration: commit on your own branch, push the branch and run \`integrate request <branch> [--deploy <scope>]\`; never
   merge into the target, push the target or run the deploy script yourself. Then keep working on anything that does not depend on it; only when nothing else is left end the turn with \`STATUS: waiting:
   integration <id>\`; the lane tells you the result (a returned request: fix it on your branch, request again).
   Never ask the owner, or end a turn waiting on anyone, for a merge or PR decision: run \`integrate request\`, then continue, or \`STATUS: waiting: integration <id>\` if nothing else is left.
   VirtualPyTest: a new script is a virtual script or a simple test case, never a file under test_scripts/ (deprecated
   2026-10-28; the commit/push/CI guard refuses one).
   A bug you find: fix it now yourself, in its own worktree, when it is small and you have the repro (it does not have to be your task); file it only when it is large, needs another host/device/credentials, is an owner-floor item, or belongs to a live session's task; never end a turn with "I filed X so someone will fix it". (owner, 2026-11-11)
   To file: \`found-bug --title ... --why-not-fixed large|other-area|host-or-device|credentials|owner-floor|live-session-task --reason "..." --repro ... --error ...
   --blocking yes|no\`; without --why-not-fixed it exits 2. A bug filed that looks small is sent back to you once. Check it exists with \`found-bug --help\`
   (Mac/cloud: \`found-bug\` posts over the tailnet with ~/.config/mycodebox/token and queues offline; missing or old on the Mac: run \`integrate self-update\`); if it is still missing, POST the same
   JSON to \`\$GHOSTY_URL/api/bugs\` with curl (docs/MAC-HOOK.md "found-bug") and say so in your report.
   This brief and the repo's AGENTS.md win over older task docs and handovers that say "no push / no merge / no
   deploy" or "the owner merges". Never hand the owner commands to run: run them yourself.
4. Ask the owner only for the hard floor: deleting data, credentials or secrets, money, customers, sudoers or system units
   on hosts, destructive database migrations (additive ones are yours), force-push or history rewrites, tag pushes or
   publishing a package, or a physical action only the owner can do (mycodebox: docs/CONTRACT.md "Who may do what").
End every turn with one STATUS line, one of the seven words of the table at the end of this brief (needs-owner only for step 4). A done line ends with
\`closing review: docs <updated list|none needed> · leftovers <none|filed ids> · unverified <none|list> · bugs: none | fixed <what> | reported <id>\`
(without it ghosty pushes once): before it, update every doc your change makes stale, fix or found-bug each leftover and
idea, and name what you did not verify (AGENTS.md "Closing review").
EOF
  [ "$WAIT" = 1 ] && printf '\nReview only (owner asked): after step 2, propose the next step and stop; do not start step 3.\n' >> "$P"
  [ -n "$TEXT" ] && printf '\nExtra instruction from the owner: %s\n' "$TEXT" >> "$P"
elif [ -n "$PFILE" ]; then { printf '%s\n\n' 'Ship rule (owner 2026-11-11): after a change run the touched tests/typecheck yourself, commit, push your branch, `integrate request <branch> [--deploy ...]`; never ask permission for these and never end a turn with an offer ("I can ...", "if you want", "should I", "nothing is committed") for something the rules already authorise; verify UI yourself with headless Playwright (skill vpt-headless-verify); end with a STATUS line.'; cat "$PFILE"; } > "$P"; BUGRULE=1
elif [ -n "$TEXT" ]; then { printf '%s\n\n' 'Ship rule (owner 2026-11-11): after a change run the touched tests/typecheck yourself, commit, push your branch, `integrate request <branch> [--deploy ...]`; never ask permission for these and never end a turn with an offer ("I can ...", "if you want", "should I", "nothing is committed") for something the rules already authorise; verify UI yourself with headless Playwright (skill vpt-headless-verify); end with a STATUS line.'; printf '%s\n' "$TEXT"; } > "$P"; BUGRULE=1
else echo "cbsession: give -H HANDOVER, -f PROMPT_FILE or -t TEXT" >&2; exit 2; fi

[ -n "$WTCMD" ] && printf '\nYour worktree is ready: %s (branch %s, made by cbsession from main before this prompt). Work only there; rename the branch if the task needs another name.\n' "$DIR" "$WTB" >> "$P"
# -f / -t prompts get the found-bugs rule too (every provider launches from this one file; owner 2026-10-28)
[ "${BUGRULE:-}" = 1 ] && printf '\nFirst command: `git worktree list`; create or reuse your worktree and work only there, never in a shared checkout.\n' >> "$P"
[ "${BUGRULE:-}" = 1 ] && printf '\nA bug you find: fix it now yourself, in its own worktree, when it is small and you have the repro (it does not have to be your task); file it only when it is large, needs another host/device/credentials, is an owner-floor item, or belongs to a live session\047s task; never end a turn with "I filed X so someone will fix it". Bug outside your scope: to file it run `found-bug --title ... --why-not-fixed large|other-area|host-or-device|credentials|owner-floor|live-session-task --reason "..." --repro ... --error ... --blocking yes|no` (check `found-bug --help`; if missing, POST the JSON to $GHOSTY_URL/api/bugs with curl, see docs/MAC-HOOK.md); never leave it in a closing line. A STATUS: done line ends with `bugs: none | fixed <what> | reported <id>`.\n' >> "$P"
[ "${BUGRULE:-}" = 1 ] && printf '\nClosing review before any STATUS: done: update every doc your change makes stale now (task doc, REFERENCE/MAP/INDEX, user guide, skill, release note); fix each leftover or file it with found-bug; file each improvement idea with found-bug; name what you did not verify. The done line carries `closing review: docs <updated list|none needed> · leftovers <none|filed ids> · unverified <none|list>`.\n' >> "$P"
# STATUS vocabulary (owner 2026-11-11, status-honesty.js): every prompt, every provider. The table is docs/STATUS-TABLE.md, verbatim.
{ printf '\n'; cat <<'STATUS_TABLE'
**The seven STATUS words (owner 2026-11-11). Take the first row that is true.**

| # | Word | Use it when | Never when | Who acts next |
|---|---|---|---|---|
| 1 | `done` | The goal is reached, you have the proof, nothing of yours is still running | A part is open, a worker or job of yours still runs, or it is "merged, not checked" | Nobody |
| 2 | `running` | Work **of yours** is still going: your background job, a worker session you started. You will be woken and continue | Nothing is actually running | Nobody; the harness wakes you |
| 3 | `waiting` | You depend on something **not yours** that ends by itself: a lane request, a deploy, a lease ticket, another session's work, a named time | You could work on something else meanwhile, or nothing will ever end it | Nobody; the harness wakes you |
| 4 | `needs-manager` | You need a decision or an answer (technical, merge, deploy, lease, design) | You have a recommendation and the choice is reversible: decide | Manager |
| 5 | `needs-owner` | Money, customers, deleting shared data, a credential only the owner holds, a physical action | Anything else | Owner |
| 6 | `blocked` | You **cannot work** and nothing running will fix it: someone must act (a device is dead, an access is missing) | Something is running or queued (that is `running` or `waiting`) | Manager |
| 7 | `failed` | You stopped and the goal is **not** reached after you tried what you could | You have not tried, or work is still running | Manager |

Forms: `done — <what> · goal: achieved · evidence: <links / run ids / frames>`; `running: <job id / worker names> — <what is left>`; `waiting: <id / ticket / session / time>`; `blocked: <what stops you> · tried: <list> · need: <who must do what>`; `failed — goal not achieved: <why> · tried: <list>`. "blocked: waiting on ..." is never right. A green / pass / proven claim carries its evidence.
STATUS_TABLE
printf '\n%s\n' 'Before you fix a filed bug, run `found-bug --claim <id>` (exit 3: someone else is fixing it).'; } >> "$P"
# Goal, Done when, Time box (owner 2026-11-11, docs/GOAL-RULE.md): a task opens and closes with the same list. The Done-when lines and the time box come from -D / -T,
# else from the brief (`Done when:` numbered lines, `Time box:`); they go into the prompt, and the server stores them with the goal in goals.json (outside the worktree).
# A start with no checkable Done-when line is REFUSED (exit 2). Exceptions that get one auto line instead (and a warning): a -t one-liner, and -A (automation: generated
# prompts of the lane, bug-drain, nightly jobs). The auto line is "the goal is reached and the result carries evidence another party can open".
SRCF=$P; [ -n "$HANDOVER" ] && SRCF=$HANDOVER
HAVE_GOAL=0; [ -n "$GOAL" ] && HAVE_GOAL=1
if [ "$HAVE_GOAL" = 0 ]; then
  GL=$(grep -m1 -iE '^[*_#> ]*goal ?:' "$SRCF" 2>/dev/null | sed -E 's/^[*_#> ]*[Gg][Oo][Aa][Ll] ?:[*_ ]*//' || true)
  [ -n "$GL" ] && { GOAL=$GL; HAVE_GOAL=1; }
fi
# numbered lines of the `Done when:` block of a file
dw_lines() { awk 'f && /^[[:space:]]*$/ {exit} tolower($0) ~ /^[*_#> -]*done[ -]when/ {f=1; next} f && /^[[:space:]]*\(?[0-9]+[.)][[:space:]]+[^[:space:]]/ {print}' "$1" 2>/dev/null || true; }
DWOUT=; INPROMPT=0
[ -n "$(dw_lines "$P")" ] && INPROMPT=1
if [ "${#DONEWHEN[@]}" -gt 0 ]; then
  n=0; for l in "${DONEWHEN[@]}"; do n=$((n+1)); DWOUT="$DWOUT$n. $l"$'\n'; done
elif [ "$INPROMPT" = 0 ]; then DWOUT=$(dw_lines "$SRCF"); [ -n "$DWOUT" ] && DWOUT="$DWOUT"$'\n'; fi
if [ -z "$DWOUT" ] && [ "$INPROMPT" = 0 ]; then
  if [ -n "$TEXT" ] && [ -z "$HANDOVER" ] && [ -z "$PFILE" ]; then
    echo "cbsession: warning: a -t one-liner has no Done-when line (-D): using one auto line (the goal is reached, with evidence another party can open). Add -D \"<checkable line>\" for a real one." >&2; AUTODW=1
  elif [ "$AUTOMATION" = 1 ]; then AUTODW=1
  else
    echo "cbsession: refused: the brief has no checkable 'Done when:' line (1 to 5 numbered lines, each checkable by something other than the session: a fact the harness holds, a command or URL with pass / fail, an artefact). Add them to the handover / prompt file, or pass -D \"<line>\" (repeatable). -A accepts an automation prompt with an auto line." >&2; exit 2
  fi
  DWOUT="1. The goal is reached, and the result carries evidence another party can open (a merged commit or integration id, a run id, a report link, a frame)."$'\n'
fi
[ -n "$DWOUT" ] && printf '\nDone when:\n%s' "$DWOUT" >> "$P"
# the Time box: -T, else the brief's `Time box:` line, else 2 h for a fix (bug* / fix* name or branch), 6 h for a feature
TB=$TIMEBOX
[ -n "$TB" ] || TB=$(grep -m1 -iE '^[*_#> -]*time[ -]?box ?[:=]' "$SRCF" 2>/dev/null | sed -E 's/^[^:=]*[:=][*_ ]*//' || true)
if [ -z "$TB" ] && ! grep -qiE '^[*_#> -]*time[ -]?box ?[:=]' "$P"; then
  case "$(tr '[:upper:]' '[:lower:]' <<<"$NAME $WTB")" in bug*|fix*|*" fix/"*|*" bug"*) TB="2 h";; *) TB="6 h";; esac
fi
[ -n "$TB" ] && printf '\nTime box: %s\n' "$TB" >> "$P"
if [ "$HAVE_GOAL" = 0 ] && ! grep -qiE '^[*_#> ]*goal ?:' "$P"; then
  echo "cbsession: warning: the brief has no 'Goal:' line (or -g); the goal check will use the first task line. Add 'Goal: <one line>'." >&2
  printf '\n%s\n' 'No `Goal:` line came with this brief: write it yourself as the first thing you say (`Goal: <one sentence>`, then `Done when:` and `Time box:`), then work.' >> "$P"
fi
# the rule text (docs/GOAL-RULE.md), verbatim, for every prompt and provider
{ printf '\n'; cat <<'GOAL_RULE'
**Goal first, verification last (owner 2026-11-11).** A task opens and closes with the same list.

- **First**: before any work, the task has `Goal: <one sentence>` and `Done when:` with 1 to 5 numbered lines, each checkable by something other than you: a fact the harness holds (merged, deployed, bug resolved), a command or URL with a pass / fail result, or an observation with an artefact (run id, report link, frame). The brief did not give them: write them yourself as the first thing you say, then work. A line you cannot check is rewritten, not dropped.
- **Time box** (owner 2026-11-11): the opening also carries `Time box: <max duration>` (the brief's, else your own estimate; default 2 h for a fix, 6 h for a feature). At 50% with no `Done when` line passed, say so and change approach. At 100% **stop**: write the `Verification:` block as it stands and end `failed` (or `needs-manager` with what would unblock it); never extend your own time box, the manager or the owner does. The same check failing 3 times with the same error is the same stop, whatever the clock says: a retry loop is not progress.
- **Last**: the final message ends with `Verification:` and one row per `Done when` line, in the same order and numbering: `<n>. pass | fail | not checked — <evidence that resolves, or why>`, then the STATUS line. All `pass` = `done`. Any `fail` or `not checked` = not `done` (`running`, `waiting` or `failed`). Never change the `Done when` list at the end to fit what you did; a line the owner dropped is marked "dropped by owner", not deleted.
- **Failing is not an ending** (owner 2026-11-12): before a `failed` line, investigate until you can name what broke (logs, frames, ledgers, code), or say what you checked and ruled out, and write the next approach. The line carries both: `STATUS: failed — goal not achieved: <why> · tried: <list> · cause: <what the investigation found> · plan: <next approach, who does it>`. A plan that is yours to do inside your time box is done, not written. A `failed` line without `cause:` and `plan:` is sent back once.
- **Done is about the task's goal, not the last request** (owner 2026-11-12): the `Goal` and the `Done when` list are the ones the task opened with. A side request given on the way (pause these deployments, check this, answer that) is reported in one sentence, and the turn ends on the task's true state: `running`, `waiting` or `needs-...` while a `Done when` line is open, never `done — goal: achieved (<the side request>)`. Only the owner or the manager replaces the goal, in words.
- **Done only with nothing open** (owner 2026-11-12): `done` needs `leftovers none` and `unverified none` in its closing review. A filed bug is not a finished task and an unverified item is a check not made: finish it, verify it, or end on the word that is true (`running`, `waiting`, `needs-manager`, `blocked`, `failed` with cause and plan). A bug outside the task goes in `bugs: reported <id>` and does not hold the line. A `done` line with anything open is sent back.
GOAL_RULE
} >> "$P"
# -g GOAL: the explicit goal right under the first line (the done-check reads it: status-honesty.js goalOf)
if [ -n "$GOAL" ]; then { head -n 1 "$P"; printf '\nGoal: %s\n' "$(printf '%s' "$GOAL" | tr '\n' ' ')"; tail -n +2 "$P"; } > "$P.tmp" && mv "$P.tmp" "$P"; fi

# -b NAME: settings file with an apiKeyHelper that reads the key file at launch (the key never lands in a file here).
CS=
if [ "$BILL" != sub ]; then
  SJ="$H/$NAME.settings.json"; WF="$HOME/.config/anthropic/$BILL.workspace"
  WS=; [ -s "$WF" ] && WS=$(tr -d '[:space:]' < "$WF")
  KF=$KF WS=$WS node -e '
    const e = process.env, o = { apiKeyHelper: `cat ${JSON.stringify(e.KF)}` };
    if (e.WS) o.env = { ANTHROPIC_CUSTOM_HEADERS: `anthropic-workspace-id: ${e.WS}` };
    process.stdout.write(JSON.stringify(o, null, 2) + "\n");' > "$SJ"
  CS=" --settings $(q "$SJ")"
fi
case $PROV in
  claude)   CMD="env -u ANTHROPIC_API_KEY -u ANTHROPIC_AUTH_TOKEN $(q "$HOME")/.local/bin/claude${CS} --dangerously-skip-permissions --remote-control $(q "$NAME") -n $(q "$NAME")${MODEL:+ --model $(q "$MODEL")} \"\$(cat $(q "$P"))\"";;
  codex)    CMD="$(q "$HOME")/.local/bin/codex --dangerously-bypass-approvals-and-sandbox${MODEL:+ -m $(q "$MODEL")} \"\$(cat $(q "$P"))\"";;
  minimax)  M=${MODEL:-MiniMax-M3}; [[ $M == */* ]] || M="minimax/$M"
            # MCODE_NODE_DIR wins; else the newest ~/.local/node-v24* (an upgrade replaces the dir, so no version is hardcoded).
            ND=${MCODE_NODE_DIR:-$({ ls -d "$HOME"/.local/node-v24*/bin 2>/dev/null || true; } | sort -V | tail -n 1)}
            MPATH="${ND:+$ND:}$HOME/.local/bin"
            # A launch that cannot find mcode says so and exits 127; it never leaves a bare shell that looks started.
            CMD="export PATH=$(q "$MPATH"):\$PATH
command -v mcode >/dev/null || { echo \"cbsession: mcode not found (PATH=\$PATH); set MCODE_NODE_DIR to the node bin dir\" >&2; exit 127; }
mcode -m $(q "$M") \"\$(cat $(q "$P"))\""
            if [ "$DRY" != 1 ] && ! PATH="$MPATH:$PATH" command -v mcode >/dev/null; then
              echo "cbsession: mcode not found in $MPATH or PATH; set MCODE_NODE_DIR to the node bin dir" >&2; exit 1
            fi;;
  opencode) CMD="$(q "$HOME")/.local/bin/opencode${MODEL:+ -m $(q "$MODEL")} --prompt \"\$(cat $(q "$P"))\" $(q "$DIR")";;
  *) echo "cbsession: -p must be claude|codex|minimax|opencode" >&2; exit 2;;
esac
# ~/.local/bin on PATH for every provider: found-bug, integrate, vpt-lease live there (a tmux server started by a service has a bare PATH)
# VPT_AGENT_NAME = the lease agent name (<host>:<session>, the vpt-lease agent): the virtualpytest MCP entry sends it as X-Agent-Name, so the host
# lease guard knows which agent drives a device (bug-c6a65805). Same name as the agent's vpt-lease claims.
printf '#!/usr/bin/env bash\nexport PATH="$HOME/.local/bin:$PATH"\nexport VPT_AGENT_NAME=%s:%s\ncd %s\n%s\n' "${VPT_AGENT_PREFIX:-$(hostname -s)}" "$NAME" "$(q "$DIR")" "$CMD" > "$L"; chmod +x "$L"
if [ "$DRY" = 1 ]; then [ -n "$WTCMD" ] && echo "worktree: $WTCMD"; echo "prompt: $P"; echo "launch: $L"; cat "$L"; exit 0; fi

# Claude: make sure the MCP entries carry the X-Agent-Name header (a no-op once set; best effort, never blocks a start).
[ "$PROV" = claude ] && command -v node >/dev/null && node "$(dirname "$(readlink -f "$0")")/vpt-mcp-agent-header.js" --apply >/dev/null 2>&1 || true
tmux new-session -d -s "$NAME" -c "$DIR" -x 160 -y 45 "bash $(q "$L"); exec bash -l"
# Claude: accept the folder-trust dialog if it appears (the selected option differs by version), then wait for Remote Control.
for i in $(seq 1 30); do
  sleep 2; S=$(tmux capture-pane -p -t "=$NAME:" 2>/dev/null || true)
  if grep -q "trust this folder" <<<"$S"; then
    grep -E "^\s*❯.*Yes" <<<"$S" >/dev/null || tmux send-keys -t "=$NAME:" Down
    sleep 1; tmux send-keys -t "=$NAME:" Enter; continue
  fi
  [ "$PROV" != claude ] && [ "$i" -ge 5 ] && break
  grep -q "remote-control is active" <<<"$S" && break
done
S=$(tmux capture-pane -p -t "=$NAME:" 2>/dev/null || true)
URL=$(grep -o "https://claude.ai/code/session_[A-Za-z0-9]*" <<<"$S" | tail -1 || true)
echo "started: $NAME ($PROV${MODEL:+ $MODEL}${CS:+, billing $BILL}) in $DIR${WTCMD:+ (worktree: $WTCMD)}"
[ "$PROV" = claude ] && { [ -n "$URL" ] && echo "remote control: $URL" || echo "remote control: not confirmed yet — check: tmux capture-pane -p -t $NAME"; }
echo "prompt: $P"

# Record who started this session (owner, 2026-10-18): env CBSESSION_BY if the caller set it; else the tmux session
# name of the calling pane ($TMUX_PANE -> `tmux display -p -t $TMUX_PANE '#S'`) so a session started by another
# session is recorded as that session; else 'cbsession' (a manual terminal run, owner by default).
STARTED_BY="${CBSESSION_BY:-}"
if [ -z "$STARTED_BY" ] && [ -n "${TMUX_PANE:-}" ] && command -v tmux >/dev/null; then
  STARTED_BY=$(tmux display -p -t "$TMUX_PANE" '#S' 2>/dev/null || true)
fi
[ -n "$STARTED_BY" ] || STARTED_BY=cbsession
export STARTED_BY

# Report the start to the dashboard's session history (loopback + reporter token). Best effort: a failure only warns,
# the tick loop records the session as 'unknown' anyway.
{
  TOKF="${GHOSTY_STATE_DIR:-$HOME/.local/state/ghosty}/reporter.token"
  if [ -r "$TOKF" ] && command -v curl >/dev/null && command -v node >/dev/null; then
    BODY=$(NAME=$NAME PROV=$PROV MODEL=$MODEL DIR=$DIR P=$P HANDOVER=$HANDOVER URL=$URL STARTED_BY="$STARTED_BY" node -e '
      const e = process.env, o = { name: e.NAME, provider: e.PROV, model: e.MODEL || null, cwd: e.DIR, prompt_ref: e.P, handover_ref: e.HANDOVER || null, started_by: e.STARTED_BY };
      if (e.URL) o.remote_control_url = e.URL; process.stdout.write(JSON.stringify(o));' 2>/dev/null) || BODY=
    [ -n "$BODY" ] && curl -fsS -m 5 -o /dev/null -X POST -H 'content-type: application/json' --config - \
      --data "$BODY" "http://127.0.0.1:${GHOSTY_PORT:-${PORT:-7777}}/api/history/started" 2>/dev/null \
      < <(printf 'header = "x-ghosty-reporter-token: %s"\n' "$(tr -d '\n' < "$TOKF")") \
      || echo "cbsession: warning: could not record the start in the session history (recorded as 'unknown' by the dashboard)" >&2
  else echo "cbsession: warning: session history not reported (no reporter token, curl or node)" >&2; fi
} || true
